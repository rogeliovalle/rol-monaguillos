function validateBackup(raw){if(!raw||raw.schema!==1||!raw.entities||typeof raw.entities!=='object'||Array.isArray(raw.entities))throw Error('Este archivo no es un respaldo válido del rol.');const s=emptyState();let count=0;for(const [key,e] of Object.entries(raw.entities)){if(++count>20000)throw Error('El respaldo es demasiado grande.');if(!['person','day','month','review'].includes(e.type)||typeof e.id!=='string'||key!==recordKey(e.type,e.id)||!e.data||typeof e.data!=='object')throw Error('Hay datos inválidos en el respaldo.');if(e.type==='person'&&(typeof e.data.name!=='string'||e.data.name.length>120||e.data.id!==e.id))throw Error('Nombre inválido.');if(e.type==='day'){if(!/^\d{4}-\d{2}-\d{2}$/.test(e.id)||!Array.isArray(e.data.masses)||e.data.masses.length>30)throw Error('Día inválido.');for(const m of e.data.masses){if(typeof m.id!=='string'||typeof m.time!=='string'||!Array.isArray(m.personIds)||m.personIds.some(x=>typeof x!=='string')||new Set(m.personIds).size!==m.personIds.length)throw Error('Misa inválida.');}}
