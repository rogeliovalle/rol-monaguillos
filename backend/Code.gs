function renderMonth_(book,records,key){const yr=+key.slice(0,4),mo=+key.slice(5,7)-1;const label=MONTHS[mo]+' '+yr;let sheet=book.getSheetByName(label);if(!sheet){const template=book.getSheetByName('Octubre 2026');sheet=template?template.copyTo(book).setName(label):book.insertSheet(label);}
