/** Conexión privada. Vincular este proyecto al Google Sheets original. */
function configurarConexion(){
 const p=PropertiesService.getScriptProperties(),book=SpreadsheetApp.getActiveSpreadsheet();
 if(!book)throw Error('Abre Apps Script desde Extensiones en tu archivo original.');
 if(p.getProperty('SPREADSHEET_ID')&&p.getProperty('SPREADSHEET_ID')!==book.getId())throw Error('Este proyecto ya está vinculado a otro archivo.');
 p.setProperty('SPREADSHEET_ID',book.getId());
 const key=Utilities.getUuid()+Utilities.getUuid(),scan=Utilities.getUuid()+Utilities.getUuid();
 p.setProperty('ROLE_KEY_HASH',digest_(key));p.setProperty('SCAN_KEY_HASH',digest_(scan));
 console.log('CLAVE DE LA APP (solo para tus teléfonos): '+key);
 console.log('CLAVE DEL BARRIDO (solo para GitHub Secrets): '+scan);
 console.log('No publiques estas claves en el repositorio. Ejecutar de nuevo revoca las claves anteriores.');
}
function configurarNotificaciones(){const value=SpreadsheetApp.getUi().prompt('Clave pública de notificaciones','Pega únicamente la clave pública VAPID. La privada se guarda solo en GitHub Secrets.',SpreadsheetApp.getUi().ButtonSet.OK_CANCEL);if(value.getSelectedButton()!==SpreadsheetApp.getUi().Button.OK)return;const key=value.getResponseText().trim();if(!/^[A-Za-z0-9_-]{80,100}$/.test(key))throw Error('Clave pública inválida');PropertiesService.getScriptProperties().setProperty('VAPID_PUBLIC_KEY',key);}
function digest_(text){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text,Utilities.Charset.UTF_8).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
function secureEqual_(a,b){if(!a||!b||a.length!==b.length)return false;let r=0;for(let i=0;i<a.length;i++)r|=a.charCodeAt(i)^b.charCodeAt(i);return r===0;}
function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
function doGet(){return json_({ok:true,app:'Rol Monaguillos',schema:1});}
function doPost(e){let lock;try{const body=JSON.parse(e.postData.contents);if(typeof body.key!=='string'||body.key.length>300)throw Error('Acceso no autorizado');const props=PropertiesService.getScriptProperties();const scan=['scan','pushResult'].includes(body.action);if(!secureEqual_(digest_(body.key),props.getProperty(scan?'SCAN_KEY_HASH':'ROLE_KEY_HASH')))throw Error('La clave de acceso no es válida.');lock=LockService.getScriptLock();lock.waitLock(25000);const book=SpreadsheetApp.openById(props.getProperty('SPREADSHEET_ID'));if(scan)return json_(scanRequest_(book,body));if(['subscribe','unsubscribe'].includes(body.action))return json_(subscriptionRequest_(book,body));if(body.action!=='sync')throw Error('Operación no disponible');return json_(syncRequest_(book,body));}catch(error){return json_({ok:false,error:error.message});}finally{if(lock&&lock.hasLock())lock.releaseLock();}}
function nativeSources_(book){return book.getSheets().filter(s=>!s.getName().startsWith('_Rol')).map(s=>({title:s.getName(),values:s.getRange(1,2,Math.min(s.getLastRow()||1,500),Math.min(s.getMaxColumns()-1,7)).getDisplayValues()}));}
function ensureStore_(book){let sheet=book.getSheetByName('_RolApp');if(!sheet){const imported=importSheets(nativeSources_(book));sheet=book.insertSheet('_RolApp');sheet.appendRow(['tipo','id','version','datos','mutacion']);for(const e of Object.values(imported.entities))sheet.appendRow([e.type,e.id,e.version,JSON.stringify(e.data),'']);sheet.hideSheet();saveHashes_(book);}return sheet;}
function records_(sheet){const rows=sheet.getLastRow()>1?sheet.getRange(2,1,sheet.getLastRow()-1,5).getValues():[];const map={};for(const r of rows)if(r[0]&&r[3])map[r[0]+':'+r[1]]={type:r[0],id:r[1],version:r[2],data:JSON.parse(r[3]),mutationId:r[4]||undefined};return map;}
function saveRecords_(sheet,map){const rows=Object.values(map).map(e=>[e.type,e.id,e.version,JSON.stringify(e.data),e.mutationId||'']);if(rows.length+1>sheet.getMaxRows())sheet.insertRowsAfter(sheet.getMaxRows(),rows.length+1-sheet.getMaxRows());if(rows.length)sheet.getRange(2,1,rows.length,5).setValues(rows);}
function monthHash_(sheet){return digest_(JSON.stringify(sheet.getRange(1,2,Math.min(sheet.getLastRow()||1,500),7).getDisplayValues()));}
function hashes_(book){const sh=book.getSheetByName('_RolHashes');return sh&&sh.getLastRow()>1?Object.fromEntries(sh.getRange(2,1,sh.getLastRow()-1,2).getValues()):{};}
function saveHashes_(book){let sh=book.getSheetByName('_RolHashes');if(!sh){sh=book.insertSheet('_RolHashes');sh.appendRow(['mes','huella']);sh.hideSheet();}const rows=book.getSheets().filter(s=>/^(Enero|Febrero|Marzo|Abril|Mayo|Junio|Julio|Agosto|Septiembre|Octubre|Noviembre|Diciembre) 20\d{2}$/.test(s.getName())).map(s=>[s.getName(),monthHash_(s)]);if(rows.length)sh.getRange(2,1,rows.length,2).setValues(rows);}
function refreshNative_(book,records){const old=hashes_(book),changed=book.getSheets().filter(s=>/^(Enero|Febrero|Marzo|Abril|Mayo|Junio|Julio|Agosto|Septiembre|Octubre|Noviembre|Diciembre) 20\d{2}$/.test(s.getName())&&old[s.getName()]!==monthHash_(s));if(!changed.length)return;const people=Object.values(records).filter(e=>e.type==='person');const imported=importSheets(changed.map(s=>({title:s.getName(),values:s.getRange(1,2,Math.min(s.getLastRow()||1,500),7).getDisplayValues()})),people.map(p=>p.data.name));const map={};for(const e of Object.values(imported.entities).filter(e=>e.type==='person')){const found=people.find(p=>normalize(p.data.name)===normalize(e.data.name)||(p.data.aliases||[]).some(a=>normalize(a)===normalize(e.data.name)));map[e.id]=found?found.id:e.id;if(!found)records['person:'+e.id]={...e,version:Utilities.getUuid()};}
 for(const e of Object.values(imported.entities).filter(e=>e.type==='day'||e.type==='month')){const key=e.type+':'+e.id;if(e.type==='day'){const oldDay=records[key]?.data;for(let i=0;i<e.data.masses.length;i++){const m=e.data.masses[i];m.personIds=[...new Set(m.personIds.map(id=>map[id]||id))];const matching=oldDay?.masses.find(x=>x.time===m.time&&x.place===m.place);if(matching)m.id=matching.id;}if(oldDay)e.data.reviewed=oldDay.reviewed;}
 if(!records[key]||JSON.stringify(records[key].data)!==JSON.stringify(e.data))records[key]={...e,version:Utilities.getUuid()};}}
function syncRequest_(book,body){if(!Array.isArray(body.changes)||body.changes.length>500)throw Error('Sincroniza un máximo de 500 cambios por vez.');for(const c of body.changes)validateChange(c);const sheet=ensureStore_(book),records=records_(sheet);let queue=book.getSheetByName('_RolRender');if(queue&&queue.getLastRow()>1){for(const key of queue.getRange(2,1,queue.getLastRow()-1,1).getValues().flat().filter(Boolean))renderMonth_(book,records,key);saveHashes_(book);queue.getRange(2,1,queue.getLastRow()-1,1).clearContent();}refreshNative_(book,records);const result=applyChanges(records,body.changes,()=>Utilities.getUuid());
 const touched=new Set(result.accepted.filter(x=>x.type==='day'||x.type==='month').map(x=>x.type==='day'?x.id.slice(0,7):x.id));
 // Guardar primero las versiones permite reintentar una solicitud cuya respuesta se perdió.
 if(!queue){queue=book.insertSheet('_RolRender');queue.appendRow(['mes pendiente']);queue.hideSheet();}if(touched.size)queue.getRange(2,1,touched.size,1).setValues([...touched].map(k=>[k]));saveRecords_(sheet,records);
 for(const key of touched)renderMonth_(book,records,key);saveHashes_(book);if(queue.getLastRow()>1)queue.getRange(2,1,queue.getLastRow()-1,1).clearContent();
 let log=book.getSheetByName('_RolHistorial');if(!log){log=book.insertSheet('_RolHistorial');log.appendRow(['id','fecha','dispositivo','tipo','registro','anterior','nuevo']);log.hideSheet();}
 const now=new Date().toISOString();for(const a of result.accepted)log.appendRow([Utilities.getUuid(),now,"'"+String(body.device||'Teléfono').slice(0,60),a.type,a.id,JSON.stringify(a.before),JSON.stringify(a.after)]);
 const tail=log.getLastRow()>1?log.getRange(Math.max(2,log.getLastRow()-99),1,Math.min(100,log.getLastRow()-1),7).getValues():[];
 return {ok:true,vapidPublicKey:PropertiesService.getScriptProperties().getProperty('VAPID_PUBLIC_KEY')||'',entities:Object.values(records),ack:result.ack,conflicts:result.conflicts,history:tail.map(r=>({id:r[0],at:r[1],label:'Sincronizado desde '+r[2]+' · '+r[4],type:r[3],entityId:r[4],before:JSON.parse(r[5]),after:JSON.parse(r[6])}))};}
function renderMonth_(book,records,key){const yr=+key.slice(0,4),mo=+key.slice(5,7)-1;const label=MONTHS[mo]+' '+yr;let sheet=book.getSheetByName(label);if(!sheet){const template=book.getSheetByName('Octubre 2026');sheet=template?template.copyTo(book).setName(label):book.insertSheet(label);}
 const weeks=monthWeeks(yr,mo),need=3+weeks.length*9;if(sheet.getMaxRows()<need+1)sheet.insertRowsAfter(sheet.getMaxRows(),need+1-sheet.getMaxRows());if(sheet.getMaxColumns()<9)sheet.insertColumnsAfter(sheet.getMaxColumns(),9-sheet.getMaxColumns());const all=sheet.getRange(3,2,Math.max(need,sheet.getLastRow())-2,7);all.breakApart();all.clearContent();all.setFontFamily('Lilita One').setFontSize(15).setFontColor('#111323').setWrap(true).setVerticalAlignment('top').setBackground('white');sheet.getRange('B2:H2').breakApart().merge().setValue(label.toUpperCase()).setFontFamily('Lilita One').setFontSize(24).setFontColor('#003fa3');sheet.getRange(3,2,1,7).setValues([WEEKDAYS.map(x=>x.toUpperCase())]).setBackground('#0260c0').setFontColor('white').setFontSize(16).setHorizontalAlignment('center');sheet.setFrozenRows(3);sheet.setHiddenGridlines(true);
 const people={};for(const e of Object.values(records))if(e.type==='person')people[e.id]=e.data.name;
 for(let w=0;w<weeks.length;w++){const row=4+w*9;let maxLines=6;for(let c=0;c<7;c++){const date=weeks[w][c],inside=+date.slice(5,7)-1===mo;const range=sheet.getRange(row,2+c,9,1);range.setBorder(true,true,true,true,false,false,'#b7cae1',SpreadsheetApp.BorderStyle.SOLID);if(!inside){range.setBackground('#f1f3f5');continue;}const day=records['day:'+date]?.data||defaultDay(date);sheet.getRange(row,2+c).setValue(+date.slice(8)).setBackground('#edf5ff').setFontSize(19).setFontColor('#003fa3');const lines=[];if(day.note)lines.push(day.note);for(const m of day.masses){const h=+m.time.slice(0,2);lines.push((h%12||12)+m.time.slice(2)+' '+(h<12?'A.M.':'P.M.')+(m.title?' · '+m.title:''));if(m.place&&m.place!=='Parroquia')lines.push(m.place);if(m.note)lines.push(m.note);lines.push(m.personIds.map(id=>people[id]||'Participante archivado').join(', ')||'Por asignar');lines.push('');}const text=lines.join('\n').trim();const body=sheet.getRange(row+1,2+c,8,1).merge();body.setRichTextValue(SpreadsheetApp.newRichTextValue().setText(text).build());if(c===0)body.setBackground('#edf5ff');maxLines=Math.max(maxLines,text.split('\n').reduce((n,l)=>n+Math.max(1,Math.ceil(l.length/22)),0));}sheet.setRowHeight(row,29);sheet.setRowHeights(row+1,8,Math.max(27,Math.ceil(maxLines*22/8)+3));}
 for(let col=2;col<=8;col++)sheet.setColumnWidth(col,220);}
function subscriptionRequest_(book,body){let sh=book.getSheetByName('_RolPush');if(!sh){sh=book.insertSheet('_RolPush');sh.appendRow(['endpoint','suscripcion','ultimo_aviso']);sh.hideSheet();}const sub=body.subscription,endpoint=body.endpoint||sub?.endpoint;if(typeof endpoint!=='string'||!/^https:\/\//.test(endpoint)||endpoint.length>3000)throw Error('Suscripción inválida');const rows=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,3).getValues():[];const i=rows.findIndex(r=>r[0]===endpoint);if(body.action==='unsubscribe'){if(i>=0)sh.deleteRow(i+2);return {ok:true};}if(!sub.keys?.p256dh||!sub.keys?.auth||JSON.stringify(sub).length>10000)throw Error('Suscripción inválida');if(i<0)sh.appendRow([endpoint,JSON.stringify(sub),'']);else sh.getRange(i+2,2).setValue(JSON.stringify(sub));return {ok:true};}
function scanRequest_(book,body){const sh=book.getSheetByName('_RolPush');if(body.action==='pushResult'){if(!sh)return {ok:true};const rows=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,3).getValues():[];const i=rows.findIndex(r=>r[0]===body.endpoint);if(i>=0){if(body.expired)sh.deleteRow(i+2);else sh.getRange(i+2,3).setValue(String(body.signature||'').slice(0,100));}return {ok:true};}const store=ensureStore_(book),records=records_(store);refreshNative_(book,records);saveRecords_(store,records);saveHashes_(book);const s={entities:records};const today=Utilities.formatDate(new Date(),'America/Monterrey','yyyy-MM-dd');const start=weekStart(today),next=parseDate(start);next.setDate(next.getDate()+7);const summaries=[weekSummary(s,start),weekSummary(s,dateKey(next))];const pending=summaries.filter(x=>x.unassigned.length);if(!pending.length)return {ok:true,targets:[]};const text=pending.map(x=>x.unassigned.map(p=>p.name).join(', ')+' no tiene'+(x.unassigned.length===1?'':'n')+' misa asignada en la semana '+x.dates[0]+' al '+x.dates[6]+(x.missingDays.length?' (hay días sin cargar)':'')+'.').join('\n');const signature=digest_(today+text);const rows=sh&&sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,3).getValues():[];return {ok:true,signature,targets:rows.filter(r=>r[2]!==signature).map(r=>({subscription:JSON.parse(r[1]),payload:{title:'Participación de monaguillos',body:text,week:start,tag:'rol-participacion'}}))};}
