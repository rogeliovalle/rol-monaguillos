function subscriptionRequest_(book,body){let sh=book.getSheetByName('_RolPush');if(!sh){sh=book.insertSheet('_RolPush');sh.appendRow(['endpoint','suscripcion','ultimo_aviso']);sh.hideSheet();}const sub=body.subscription,endpoint=body.endpoint||sub?.endpoint;if(typeof endpoint!=='string'||!/^https:\/\//.test(endpoint)||endpoint.length>3000)throw Error('Suscripción inválida');const rows=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,3).getValues():[];const i=rows.findIndex(r=>r[0]===endpoint);if(body.action==='unsubscribe'){if(i>=0)sh.deleteRow(i+2);return {ok:true};}if(!sub.keys?.p256dh||!sub.keys?.auth||JSON.stringify(sub).length>10000)throw Error('Suscripción inválida');if(i<0)sh.appendRow([endpoint,JSON.stringify(sub),'']);else sh.getRange(i+2,2).setValue(JSON.stringify(sub));return {ok:true};}
