function mergePeople(s,keepId,dropId){if(keepId===dropId)throw Error('Selecciona dos nombres distintos.');const keep=s.entities[recordKey('person',keepId)]?.data;const drop=s.entities[recordKey('person',dropId)]?.data;if(!keep||!drop)throw Error('Nombre no encontrado');for(const d of list(s,'day')){if(d.masses.some(m=>m.personIds.includes(dropId))){const day=clone(d);for(const m of day.masses)m.personIds=[...new Set(m.personIds.map(id=>id===dropId?keepId:id))];change(s,'day',day.date,day,`Unificar ${drop.name} con ${keep.name}`);}}
