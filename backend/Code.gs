 s.history=[{id:'importacion-inicial',at:new Date().toISOString(),label:'Carga inicial desde los roles; variantes históricas pendientes de revisión',type:'import'}];return s;
}

// Núcleo puro compartido con las pruebas. Google Apps Script lo recibe sin export.
function validateChange(c){if(!c||!['person','day','month','review'].includes(c.type)||typeof c.id!=='string'||c.id.length>100||typeof c.mutationId!=='string'||!c.data||JSON.stringify(c.data).length>45000)throw Error('Cambio inválido');if(c.type==='person'){if(typeof c.data.name!=='string'||!c.data.name.trim()||c.data.name.length>120||c.data.id!==c.id)throw Error('Nombre inválido');}if(c.type==='day'){if(!/^\d{4}-\d{2}-\d{2}$/.test(c.id)||c.data.date!==c.id||!Array.isArray(c.data.masses)||c.data.masses.length>30)throw Error('Día inválido');for(const m of c.data.masses)if(typeof m.id!=='string'||!/^([01]\d|2[0-3]):[0-5]\d$/.test(m.time)||!Array.isArray(m.personIds)||m.personIds.some(id=>typeof id!=='string')||new Set(m.personIds).size!==m.personIds.length)throw Error('Misa inválida');}if(c.type==='month'&&(!/^\d{4}-\d{2}$/.test(c.id)||c.data.key!==c.id||!Number.isInteger(c.data.year)||c.data.year<1900||c.data.year>2200||!Number.isInteger(c.data.month)||c.data.month<0||c.data.month>11))throw Error('Mes inválido');}
function applyChanges(records,changes,newVersion){const result={entities:records,ack:[],conflicts:[],accepted:[]};for(const c of changes){validateChange(c);const key=c.type+':'+c.id,current=records[key];if(current?.mutationId===c.mutationId){result.ack.push({key,version:current.version});continue;}if((current?.version||null)!==(c.baseVersion||null)||(c.baseData&&current&&JSON.stringify(c.baseData)!==JSON.stringify(current.data))){result.conflicts.push({key,remote:current||null});continue;}const value={type:c.type,id:c.id,data:JSON.parse(JSON.stringify(c.data)),version:newVersion(),mutationId:c.mutationId};records[key]=value;result.ack.push({key,version:value.version});result.accepted.push({key,before:current?.data||null,after:value.data,type:c.type,id:c.id});}return result;}

/** Conexión privada. Vincular este proyecto al Google Sheets original. */
function configurarConexion(){
 const p=PropertiesService.getScriptProperties(),book=SpreadsheetApp.getActiveSpreadsheet();
 if(!book)throw Error('Abre Apps Script desde Extensiones en tu archivo original.');
 if(p.getProperty('SPREADSHEET_ID')&&p.getProperty('SPREADSHEET_ID')!==book.getId())throw Error('Este proyecto ya está vinculado a otro archivo.');
 p.setProperty('SPREADSHEET_ID',book.getId());
 const key=Utilities.getUuid()+Utilities.getUuid(),scan=Utilities.getUuid()+Utilities.getUuid();
 p.setProperty('ROLE_KEY_HASH',digest_(key));p.setProperty('SCAN_KEY_HASH',digest_(scan));
 console.log('CLAVE DE LA APP (solo para tus teléfonos): '+key);
 console.log('CLAVE DEL BARRIDO (solo para GitHub Secrets): '+scan);
 console.log('No publiques estas claves en el repositorio. Ejecutar de nuevo revoca las claves anteriores.');
}
function configurarNotificaciones(){const value=SpreadsheetApp.getUi().prompt('Clave pública de notificaciones','Pega únicamente la clave pública VAPID. La privada se guarda solo en GitHub Secrets.',SpreadsheetApp.getUi().ButtonSet.OK_CANCEL);if(value.getSelectedButton()!==SpreadsheetApp.getUi().Button.OK)return;const key=value.getResponseText().trim();if(!/^[A-Za-z0-9_-]{80,100}$/.test(key))throw Error('Clave pública inválida');PropertiesService.getScriptProperties().setProperty('VAPID_PUBLIC_KEY',key);}
