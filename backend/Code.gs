function emptyState(){return {schema:1,entities:{},pending:{},history:[],conflicts:[],lastSync:null};}
const recordKey=(type,id)=>`${type}:${id}`;
function list(s,type){return Object.values(s.entities).filter(e=>e.type===type&&!e.deleted).map(e=>e.data);}
function getDay(s,k){return s.entities[recordKey('day',k)]?.data||defaultDay(k);}
function change(s,type,id,data,label){const key=recordKey(type,id);const before=s.entities[key];const record={type,id,version:before?.version||null,data:clone(data),deleted:false};const pending=s.pending[key];s.pending[key]={...record,baseVersion:pending?pending.baseVersion:before?.version||null,baseData:pending?pending.baseData:before?clone(before.data):null,mutationId:uid()};s.entities[key]=record;s.history.unshift({id:uid(),at:new Date().toISOString(),label,type,entityId:id,before:before?clone(before.data):null,after:clone(data)});s.history=s.history.slice(0,800);return record;}
