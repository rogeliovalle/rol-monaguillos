function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
function doGet(){return json_({ok:true,app:'Rol Monaguillos',schema:1});}
function doPost(e){let lock;try{const body=JSON.parse(e.postData.contents);if(typeof body.key!=='string'||body.key.length>300)throw Error('Acceso no autorizado');const props=PropertiesService.getScriptProperties();const scan=['scan','pushResult'].includes(body.action);if(!secureEqual_(digest_(body.key),props.getProperty(scan?'SCAN_KEY_HASH':'ROLE_KEY_HASH')))throw Error('La clave de acceso no es válida.');lock=LockService.getScriptLock();lock.waitLock(25000);const book=SpreadsheetApp.openById(props.getProperty('SPREADSHEET_ID'));if(scan)return json_(scanRequest_(book,body));if(['subscribe','unsubscribe'].includes(body.action))return json_(subscriptionRequest_(book,body));if(body.action!=='sync')throw Error('Operación no disponible');return json_(syncRequest_(book,body));}catch(error){return json_({ok:false,error:error.message});}finally{if(lock&&lock.hasLock())lock.releaseLock();}}
function nativeSources_(book){return book.getSheets().filter(s=>!s.getName().startsWith('_Rol')).map(s=>({title:s.getName(),values:s.getRange(1,2,Math.min(s.getLastRow()||1,500),Math.min(s.getMaxColumns()-1,7)).getDisplayValues()}));}
