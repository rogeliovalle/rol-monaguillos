function syncRequest_(book,body){if(!Array.isArray(body.changes)||body.changes.length>500)throw Error('Sincroniza un máximo de 500 cambios por vez.');for(const c of body.changes)validateChange(c);const sheet=ensureStore_(book),records=records_(sheet);let queue=book.getSheetByName('_RolRender');if(queue&&queue.getLastRow()>1){for(const raw of queue.getRange(2,1,queue.getLastRow()-1,1).getValues().flat().filter(Boolean)){const key=raw instanceof Date?Utilities.formatDate(raw,'America/Monterrey','yyyy-MM'):String(raw);renderMonth_(book,records,key);}saveHashes_(book);queue.getRange(2,1,queue.getLastRow()-1,1).clearContent();}refreshNative_(book,records);const result=applyChanges(records,body.changes,()=>Utilities.getUuid());
