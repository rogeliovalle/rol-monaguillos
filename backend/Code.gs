function assign(day,massId,personId){const mass=day.masses.find(m=>m.id===massId);if(!mass)throw Error('Misa no encontrada');if(!mass.personIds.includes(personId))mass.personIds.push(personId);}
function weekSummary(s,k){const dates=weekDates(k);const active=list(s,'person').filter(p=>p.active!==false&&!p.mergedInto);const counts=Object.fromEntries(active.map(p=>[p.id,0]));let emptyMasses=0;const missingDays=[];for(const key of dates){const rec=s.entities[recordKey('day',key)];if(!rec){missingDays.push(key);continue;}for(const m of rec.data.masses){if(!m.personIds.length)emptyMasses++;for(const id of new Set(m.personIds))if(id in counts)counts[id]++;}}return {dates,counts,unassigned:active.filter(p=>!counts[p.id]),active,emptyMasses,missingDays,reviewed:dates.filter(k=>s.entities[recordKey('day',k)]?.data.reviewed).length};}
function mergeResponse(s,response,sent={}){for(const [key,e] of Object.entries(s.entities)){const canonical=e.type==='day'?e.data.date:e.type==='month'?e.data.key:e.id;if(e.id!==canonical&&!s.pending[key])delete s.entities[key];}const remote=new Map(response.entities.map(e=>[recordKey(e.type,e.id),e]));const ack=new Map((response.ack||[]).map(x=>[x.key,x]));for(const [key,a] of ack){if(!s.pending[key])continue;if(s.pending[key].mutationId===sent[key]?.mutationId)delete s.pending[key];else s.pending[key].baseVersion=a.version;}
